# ACS orchestrator 生产运行参数（声明式，随 acs-sandbox.yml 自动 apply）
#
# 2026-08-10 建立。此前这些值只存在于 ECS 上手写的
# /etc/agent-saas/acs-orchestrator.env，没有版本控制、没有审计、改错只能人肉回滚。
# 现在改参数 = 改本文件 + 走 CI，git log 即变更史，git revert 即回滚。
#
# ── 边界（重要）──
# 1. 只放**非敏感**参数。token/secret/密码一律留在 ECS 上的 env，本文件不涉及，
#    apply 脚本也不会删除未在此声明的键。
# 2. 不放 ACS_SANDBOX_IMAGE：它是构建产物，由 CI 按本次镜像 tag 动态注入。
# 3. 不放机器相关路径（kubeconfig / pidfile 等）：属于主机事实，不是应用配置。
# 4. 改动这里的值需要 orchestrator 重启才生效——CI 的 drain 流程会处理。

# ── Sandbox 规格 ──
# 2026-08-10（A 方案批次 2）：limit 1C2G → 2C4G。
# 依据：per-session 后单 pod 承载「父会话 + 其全部子 Agent」，1 核假设失效；
# 旧 1C2G pod 实测 oom_kill 累计 10 次、内存长期 87.6% 水位、
# wait_sum/cpuacct=3.24（CPU 排队是实际执行的 3 倍）。
# 2026-08-11：request 同步到 2C4G，与已计费规格一致，使 Sandbox 获得 Guaranteed QoS；
# 生产 namespace 无 ResourceQuota/LimitRange，不牺牲当前调度容量。
ACS_SANDBOX_CPU_REQUEST=2
ACS_SANDBOX_MEMORY_REQUEST=4Gi
ACS_SANDBOX_CPU_LIMIT=2
ACS_SANDBOX_MEMORY_LIMIT=4Gi

# ── 生命周期与 rollout ──
# 2026-09-01：第五轮 TTL rollout 在生产显式启用 workload-aware enforce。
ACS_SANDBOX_LIFECYCLE_ENABLED=true
ACS_SANDBOX_LIFECYCLE_POLICY_MODE=enforce
# idle pause 5min：08-10 实测 pause 300s/900s 后 resume 均 0 秒且 pod uid 不变
# （原 pod 恢复走快路径），07-31「唤醒走删除重建 35-110s」的观测已不成立。
# per-session 后 pod 数 = 顶层会话组数，idle 窗口直接决定总 pod·h。
ACS_SANDBOX_IDLE_PAUSE_MS=300000
# 2026-08-27：普通会话与 Taskboard 最后活动满 30min 后删除 Sandbox CR，释放
# 休眠态仍计费的 30GiB 临时存储；NAS workspace 与会话历史不受影响。
# ACS 部署冒烟由显式删除清理；异常残留仍按 30min inactive cap 回收。
ACS_SANDBOX_TTL_MS=1800000
# 高位安全阀，用途是挡 bug 风暴而非限制正常使用（曾磊 08-10 拍板不设业务配额）。
# 所有仍存在的 Sandbox CR（含 Creating/Paused/Deleting）都计入，不再把 Paused 当免费库存。
# 超限只会删除无 active run/后台保护的最旧 Paused；绝不强停 Running。
# 2026-08-30：平台同时存在 daily 1C2G 与 coding 2C4G，数量门禁提升到 7000；
# CPU/内存仍按真实规格加权，任一门禁命中即拒绝。两个 /20 VSwitch 当前可用地址合计
# 8145，7000 上限保留 1145 个地址余量；shared-cidr SNAT 条目数与 Pod 数解耦。
ACS_SANDBOX_MAX_RUNNING=7000
ACS_SANDBOX_WARN_RUNNING=6000
# CPU/内存硬上限与阿里云深圳地域获批容量一致；混合规格按真实资源加权。
# 资源告警保持 90% 水位，数量告警按 6000/7000 独立设置。
ACS_SANDBOX_MAX_ALLOCATED_CPU_MILLICORES=10000000
ACS_SANDBOX_WARN_ALLOCATED_CPU_MILLICORES=9000000
ACS_SANDBOX_MAX_ALLOCATED_MEMORY_MIB=20480000
ACS_SANDBOX_WARN_ALLOCATED_MEMORY_MIB=18432000

# ── SNAT ──
# 2026-08-24：shared-cidr 必须完整覆盖 ACK 声明的两个 ACS VSwitch 地址池：
# 172.16.176.0/20（cn-shenzhen-d）与 172.18.176.0/20（cn-shenzhen-c）。
# 云 SNAT 最宽按 /24 管理，因此显式展开为 32 条；禁止再按历史 Pod 样本删减范围。
# 未匹配网段 fail-closed 并告警，禁止静默退化 per-Pod。启动仅创建并确认共享条目，
# 活跃/Paused /32 必须在真实网络验收后通过受保护迁移端点显式删除。
ACS_SNAT_MODE=shared-cidr
# 旧变量保留空值作为部署 tombstone：apply 脚本只 upsert、不删除未声明键。
ACS_SNAT_SHARED_CIDR=
ACS_SNAT_SHARED_CIDRS=172.16.176.0/24,172.16.177.0/24,172.16.178.0/24,172.16.179.0/24,172.16.180.0/24,172.16.181.0/24,172.16.182.0/24,172.16.183.0/24,172.16.184.0/24,172.16.185.0/24,172.16.186.0/24,172.16.187.0/24,172.16.188.0/24,172.16.189.0/24,172.16.190.0/24,172.16.191.0/24,172.18.176.0/24,172.18.177.0/24,172.18.178.0/24,172.18.179.0/24,172.18.180.0/24,172.18.181.0/24,172.18.182.0/24,172.18.183.0/24,172.18.184.0/24,172.18.185.0/24,172.18.186.0/24,172.18.187.0/24,172.18.188.0/24,172.18.189.0/24,172.18.190.0/24,172.18.191.0/24
ACS_SNAT_MAX_MANAGED_ENTRIES=200
ACS_SNAT_STABILIZE_AFTER_CREATE_MS=8000

# ── 超时 ──
ACS_SANDBOX_WAIT_TIMEOUT_MS=180000
ACS_EXEC_TIMEOUT_MS=600000
ACS_SNAT_REQUEST_TIMEOUT_MS=20000

# ── 其他运行参数 ──
ACS_SKIP_PROVISION_ON_SAME_RECIPE=true
ACS_ORCH_LOG_LEVEL=info
