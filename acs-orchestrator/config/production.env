# ACS orchestrator 生产运行参数（声明式，随 acs-sandbox.yml 自动 apply）
#
# 2026-08-10 建立。此前这些值只存在于 ECS 上手写的
# /etc/agent-saas/acs-orchestrator.env，没有版本控制、没有审计、改错只能人肉回滚。
# 现在改参数 = 改本文件 + 走 CI，git log 即变更史，git revert 即回滚。
#
# ── 边界（重要）──
# 1. 只放**非敏感**参数。token/secret/密码一律留在 ECS 上的 env，本文件不涉及，
#    apply 脚本也不会删除未在此声明的键。
# 2. 不放 ACS_SANDBOX_IMAGE：它是构建产物，由 CI 按本次镜像 tag 动态注入。
# 3. 不放机器相关路径（kubeconfig / pidfile 等）：属于主机事实，不是应用配置。
# 4. 改动这里的值需要 orchestrator 重启才生效——CI 的 drain 流程会处理。

# ── Sandbox 规格 ──
# 2026-08-10（A 方案批次 2）：limit 1C2G → 2C4G。
# 依据：per-session 后单 pod 承载「父会话 + 其全部子 Agent」，1 核假设失效；
# 旧 1C2G pod 实测 oom_kill 累计 10 次、内存长期 87.6% 水位、
# wait_sum/cpuacct=3.24（CPU 排队是实际执行的 3 倍）。
# 2026-08-11：request 同步到 2C4G，与已计费规格一致，使 Sandbox 获得 Guaranteed QoS；
# 生产 namespace 无 ResourceQuota/LimitRange，不牺牲当前调度容量。
ACS_SANDBOX_CPU_REQUEST=2
ACS_SANDBOX_MEMORY_REQUEST=4Gi
ACS_SANDBOX_CPU_LIMIT=2
ACS_SANDBOX_MEMORY_LIMIT=4Gi

# ── 生命周期 ──
# idle pause 5min：08-10 实测 pause 300s/900s 后 resume 均 0 秒且 pod uid 不变
# （原 pod 恢复走快路径），07-31「唤醒走删除重建 35-110s」的观测已不成立。
# per-session 后 pod 数 = 顶层会话组数，idle 窗口直接决定总 pod·h。
ACS_SANDBOX_IDLE_PAUSE_MS=300000
# 高位安全阀，用途是挡 bug 风暴而非限制正常使用（曾磊 08-10 拍板不设业务配额）。
# ⚠️ 该值以 ACS_SNAT_MODE=shared-cidr 为前提：per-sandbox 下 SNAT 超限直接 throw
# 且无降级，而 maxRunning 超限走 LRU pause 有优雅降级，应该先撞 maxRunning 这道墙。
ACS_SANDBOX_MAX_RUNNING=200
ACS_SANDBOX_WARN_RUNNING=150

# ── SNAT ──
# 2026-08-10：per-sandbox → shared-cidr。整个 pod 网段共用一条条目，
# pod 数与 SNAT 条目彻底解耦，且新 pod 不再需要建条目 → 省掉每次 8s 传播等待。
# 核查依据见 assets/20260810/acs-a/03-SNAT网段共享可行性核查.md：
# per-pod 无隔离语义（所有条目指向同一 SnatIp），生产 pod 7 天实测全部落在
# 172.16.179.0/24，而 ECS 在 172.16.177.x 且各持公网 IP 不经 SNAT。
ACS_SNAT_MODE=shared-cidr
ACS_SNAT_SHARED_CIDR=172.16.179.0/24
ACS_SNAT_MAX_MANAGED_ENTRIES=28
ACS_SNAT_STABILIZE_AFTER_CREATE_MS=8000

# ── 超时 ──
ACS_SANDBOX_WAIT_TIMEOUT_MS=180000
ACS_EXEC_TIMEOUT_MS=600000
ACS_SNAT_REQUEST_TIMEOUT_MS=20000

# ── 其他运行参数 ──
ACS_SKIP_PROVISION_ON_SAME_RECIPE=true
ACS_ORCH_LOG_LEVEL=info
