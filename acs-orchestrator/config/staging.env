# Non-secret Staging ACS settings, including explicit lifecycle rollout mode. Secrets are injected only by the GitHub staging Environment.
ACS_NAMESPACE=agent-saas-staging
ACS_WORKSPACE_PVC=agent-saas-staging-workspace
ACS_SERVICE_ACCOUNT=agent-saas-staging-orchestrator
ACS_SANDBOX_CPU_REQUEST=1
ACS_SANDBOX_MEMORY_REQUEST=2Gi
ACS_SANDBOX_CPU_LIMIT=2
ACS_SANDBOX_MEMORY_LIMIT=4Gi
ACS_SANDBOX_IDLE_PAUSE_MS=300000
ACS_SANDBOX_LIFECYCLE_POLICY_MODE=enforce
ACS_SANDBOX_TTL_MS=1800000
ACS_SANDBOX_MAX_RUNNING=10
ACS_SANDBOX_WARN_RUNNING=8
ACS_SANDBOX_MAX_ALLOCATED_CPU_MILLICORES=20000
ACS_SANDBOX_WARN_ALLOCATED_CPU_MILLICORES=16000
ACS_SANDBOX_MAX_ALLOCATED_MEMORY_MIB=40960
ACS_SANDBOX_WARN_ALLOCATED_MEMORY_MIB=32768
ACS_SNAT_MODE=shared-cidr
ACS_SNAT_SHARED_CIDR=
ACS_SNAT_SHARED_CIDRS=172.16.176.0/24,172.16.177.0/24,172.16.178.0/24,172.16.179.0/24,172.16.180.0/24,172.16.181.0/24,172.16.182.0/24,172.16.183.0/24,172.16.184.0/24,172.16.185.0/24,172.16.186.0/24,172.16.187.0/24,172.16.188.0/24,172.16.189.0/24,172.16.190.0/24,172.16.191.0/24,172.18.176.0/24,172.18.177.0/24,172.18.178.0/24,172.18.179.0/24,172.18.180.0/24,172.18.181.0/24,172.18.182.0/24,172.18.183.0/24,172.18.184.0/24,172.18.185.0/24,172.18.186.0/24,172.18.187.0/24,172.18.188.0/24,172.18.189.0/24,172.18.190.0/24,172.18.191.0/24
ACS_SNAT_MAX_MANAGED_ENTRIES=200
ACS_SNAT_STABILIZE_AFTER_CREATE_MS=8000
ACS_SANDBOX_WAIT_TIMEOUT_MS=180000
ACS_EXEC_TIMEOUT_MS=600000
ACS_SNAT_REQUEST_TIMEOUT_MS=20000
ACS_SKIP_PROVISION_ON_SAME_RECIPE=true
ACS_ORCH_LOG_LEVEL=info
