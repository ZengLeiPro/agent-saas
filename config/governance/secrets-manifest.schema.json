{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.kaiyan.net/config/governance/secrets-manifest.schema.json",
  "title": "KY Agent secret readiness manifest",
  "type": "object",
  "required": ["schemaVersion", "environment", "secrets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "enum": ["development", "staging", "production", "test"] },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "state"],
        "properties": {
          "path": { "type": "string" },
          "state": { "enum": ["ref", "inline_legacy", "missing", "environment"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
