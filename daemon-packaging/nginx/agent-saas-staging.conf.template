upstream agent_saas_staging_api {
    server 127.0.0.1:3210;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name staging-agent-api.kaiyan.net;

    ssl_certificate /etc/agent-saas-staging/tls/fullchain.pem;
    ssl_certificate_key /etc/agent-saas-staging/tls/privkey.pem;

    location / {
        proxy_pass http://agent_saas_staging_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1800s;
    }
}
