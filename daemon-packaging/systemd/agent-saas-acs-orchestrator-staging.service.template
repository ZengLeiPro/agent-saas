[Unit]
Description=Agent SaaS Staging ACS Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-saas-staging/current/acs-orchestrator
Environment=NODE_ENV=production
Environment=AGENT_SAAS_ENVIRONMENT=staging
Environment=ACS_ORCH_PORT=3410
Environment=ACS_NAMESPACE=agent-saas-staging
Environment=ACS_WORKSPACE_PVC=agent-saas-staging-workspace
Environment=ACS_SERVICE_ACCOUNT=agent-saas-staging-orchestrator
Environment=ACS_ORCH_RUNTIME_CONFIG_FILE=/var/lib/agent-saas-staging/acs/runtime-config.json
Environment=ACS_RELEASE_IDENTITY_FILE=/etc/agent-saas-staging/acs-release-identity.json
Environment=ACS_ORCH_PIDFILE=/run/agent-saas-acs-orchestrator-staging.pid
Environment=KUBECONFIG=/etc/agent-saas-staging/kubeconfig
EnvironmentFile=/etc/agent-saas-staging/acs-orchestrator.env
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=660
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run /var/lib/agent-saas-staging /mnt/agent-saas-staging

[Install]
WantedBy=multi-user.target
