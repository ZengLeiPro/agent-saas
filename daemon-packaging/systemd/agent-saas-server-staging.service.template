[Unit]
Description=Agent SaaS Staging API
After=network-online.target remote-fs.target agent-saas-acs-orchestrator-staging.service
Wants=network-online.target
RequiresMountsFor=/mnt/agent-saas-staging

[Service]
Type=simple
User=agent-saas-staging
Group=agent-saas-staging
RuntimeDirectory=agent-saas-staging
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# ConfigIdentity 摘要只落在私有 RuntimeDirectory，不进入匿名 health 响应，也不与 Worker 共用。
WorkingDirectory=/mnt/agent-saas-staging/runtime/server
Environment=NODE_ENV=production
Environment=AGENT_SAAS_ENVIRONMENT=staging
Environment=AGENT_SAAS_STAGING_RELEASE_ROOT=/opt/agent-saas-staging
Environment=AGENT_SAAS_PROCESS_ROLE=ws-only
Environment=AGENT_SAAS_CONFIG_PATH=/var/lib/agent-saas-staging/config/config.json
Environment=AGENT_SAAS_PIDFILE=/run/agent-saas-staging/server.pid
Environment=AGENT_SAAS_ACTIVE_RUNTIME_WORKER_READYFILE=/run/agent-saas-staging/runtime-worker.ready
Environment=KB_PREVIEW_AUTO_GENERATE=false
EnvironmentFile=/etc/agent-saas-staging/server.env
# 进程私有路径放在共享 EnvironmentFile 之后，避免历史配置覆盖。
Environment=AGENT_SAAS_CONFIG_IDENTITY_PATH=/run/agent-saas-staging/config-identity.json
ExecStartPre=/usr/bin/rm -f /run/agent-saas-staging/config-identity.json
ExecStartPre=/usr/bin/node /opt/agent-saas-staging/current/server/dist/runtime-dependency.mjs --manifest=/opt/agent-saas-staging/current/server/runtime-dependencies.json --component=server --production=true
ExecStart=/usr/bin/node --enable-source-maps /opt/agent-saas-staging/current/server/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run /var/lib/agent-saas-staging /mnt/agent-saas-staging

[Install]
WantedBy=multi-user.target
