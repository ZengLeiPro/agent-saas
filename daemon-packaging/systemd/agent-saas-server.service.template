[Unit]
Description=Agent SaaS Server
After=network-online.target remote-fs.target agent-saas-acs-orchestrator.service
Wants=network-online.target
RequiresMountsFor=/mnt/agent-workspaces /mnt/agent-saas

[Service]
Type=simple
WorkingDirectory=/opt/agent-saas-app/current/server
Environment=NODE_ENV=production
Environment=AGENT_SAAS_CONFIG_PATH=/etc/agent-saas/config.json
Environment=AZEROTH_TOKENS_FILE=/etc/agent-saas/azeroth-tokens.json
EnvironmentFile=/etc/agent-saas/server.env
# 生产环境身份是启动硬约束，必须覆盖共享 env 中可能残留的旧值
Environment=AGENT_SAAS_ENVIRONMENT=production
ExecStartPre=/usr/bin/node dist/runtime-dependency.mjs --manifest=runtime-dependencies.json --component=server --production=true
ExecStart=/usr/local/bin/pnpm start
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
