{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaiyan.example/schemas/mobile-native-e2e-receipt-1.0.0.json",
  "title": "M60-02 native E2E evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "receiptId", "contract", "device", "run", "flowHash", "flows", "artifacts", "integrity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceKind": { "enum": ["real-device", "deterministic-mock"] },
    "receiptId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "flowHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "device", "osVersion", "osRole", "deviceClass", "buildSha", "sourceHead", "appId", "version", "signingFingerprint", "testRunId", "slot"],
      "properties": {
        "platform": { "enum": ["ios", "android"] },
        "device": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "osRole": { "enum": ["minimum", "latest", "current"] },
        "deviceClass": { "type": "string", "minLength": 1 },
        "buildSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "appId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "signingFingerprint": { "type": "string", "pattern": "^[a-f0-9:]{32,}$" },
        "testRunId": { "type": "string", "minLength": 1 },
        "slot": { "enum": ["ios-minimum", "ios-latest", "android-flagship", "android-low-end-small"] }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical", "virtual", "browser", "providerName", "providerRunId", "deviceIdentifierHash", "model"],
      "properties": {
        "physical": { "type": "boolean" }, "virtual": { "type": "boolean" }, "browser": { "type": "boolean" },
        "providerName": { "type": "string" }, "providerRunId": { "type": "string" },
        "deviceIdentifierHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "model": { "type": "string" }
      }
    },
    "run": { "type": "object", "required": ["completedAt", "status"], "properties": { "completedAt": { "type": "string", "format": "date-time" }, "status": { "enum": ["passed", "failed"] }, "fixtureVersion": { "type": ["string", "null"] } }, "additionalProperties": false },
    "flows": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "status", "durationMs", "error"], "properties": { "id": { "type": "string" }, "status": { "enum": ["passed", "failed"] }, "durationMs": { "type": "integer", "minimum": 0 }, "error": { "type": ["string", "null"] } }, "additionalProperties": false } },
    "artifacts": { "type": "object" },
    "integrity": { "type": "object", "required": ["algorithm", "payloadSha256", "hmacSha256"], "properties": { "algorithm": { "const": "HMAC-SHA256" }, "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "hmacSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }
  }
}
