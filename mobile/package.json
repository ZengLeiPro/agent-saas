{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "./scripts/build.sh",
    "build:ios": "./scripts/build.sh ios",
    "build:android": "./scripts/build.sh android",
    "build:ios:only": "./scripts/build.sh ios --build",
    "submit:ios": "./scripts/build.sh ios --submit",
    "typecheck": "tsc --noEmit",
    "check:expo": "pnpm exec expo install --check",
    "test": "vitest run && node --test plugins/withAndroidSigningConfig.test.js plugins/withMobilePrivacyControls.test.js scripts/release-manifest.test.mjs scripts/android-distribution.test.mjs scripts/enterprise-update-manifest.test.mjs scripts/mobile-privacy-policy.test.mjs scripts/incoming-share-config.test.mjs scripts/native-policy.test.mjs scripts/mobile-release-evidence.test.mjs scripts/authorize-mobile-release-source.test.mjs scripts/mobile-release-workflows.test.mjs scripts/mobile-telemetry-release-gate.test.mjs e2e/maestro/tests/native-e2e.test.mjs",
    "test:m60-02": "node --test e2e/maestro/tests/native-e2e.test.mjs",
    "lint:maestro": "node e2e/maestro/scripts/lint-maestro.mjs",
    "test:m60-02:prebuild": "bash scripts/test-m60-02-prebuild-smoke.sh",
    "test:m60-03": "node --test scripts/native-policy.test.mjs",
    "test:m60-03:prebuild": "node scripts/run-native-prebuild-gate.mjs --profile all",
    "test:m60-04": "node --test scripts/mobile-release-evidence.test.mjs scripts/authorize-mobile-release-source.test.mjs scripts/mobile-release-workflows.test.mjs",
    "validate:m60-04:evidence": "node scripts/mobile-release-evidence.mjs",
    "generate:m60-04:sbom": "node scripts/generate-mobile-release-sbom.mjs",
    "test:m10-04": "vitest run src/updates/enterpriseUpdateManifest.test.ts src/updates/enterpriseUpdaterConfig.test.ts src/updates/sha256File.test.ts && node --test scripts/android-distribution.test.mjs scripts/enterprise-update-manifest.test.mjs plugins/withAndroidSigningConfig.test.js",
    "test:m10-05": "vitest run src/platform/jitMediaPermissions.test.ts && node --test scripts/mobile-privacy-policy.test.mjs plugins/withMobilePrivacyControls.test.js",
    "test:m10-05:prebuild": "bash scripts/test-mobile-privacy-prebuild.sh",
    "test:release-manifest": "node --test scripts/release-manifest.test.mjs",
    "test:android-distributions:prebuild": "bash scripts/test-android-distributions-prebuild.sh",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs --profile preview",
    "test:android-signing": "node --test plugins/withAndroidSigningConfig.test.js && node scripts/verify-android-signing.mjs --source-only && expo prebuild --clean --no-install --platform android && node scripts/verify-android-signing.mjs android/app/build.gradle",
    "test:android-signing:gradle": "node scripts/assert-android-release-fail-closed.mjs",
    "prepare:enterprise-update": "node scripts/prepare-enterprise-update.mjs",
    "validate:native-e2e-evidence": "node e2e/maestro/scripts/validate-evidence.mjs",
    "test:m60-05": "vitest run src/telemetry/telemetryClient.test.ts && node --test scripts/mobile-telemetry-release-gate.test.mjs",
    "validate:m60-05:release": "node scripts/mobile-telemetry-release-gate.mjs"
  },
  "dependencies": {
    "@agent/shared": "workspace:*",
    "@expo/config-plugins": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-documents/viewer": "^4.0.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@shopify/flash-list": "2.0.2",
    "base64-js": "1.5.1",
    "expo": "~55.0.30",
    "expo-application": "~55.0.19",
    "expo-audio": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-share-intent": "^6.1.0",
    "expo-sharing": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "lucide-react-native": "^1.24.0",
    "marked": "^18.0.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "~1.20.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "expo-constants": "^55.0.17",
    "expo-local-authentication": "~55.0.18"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "18.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "private": true
}
