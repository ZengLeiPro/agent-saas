{
  "name": "agent-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "pnpm -F server dev",
    "dev:web": "pnpm -F web dev",
    "dev:backend": "pnpm run dev:server",
    "dev:frontend": "pnpm run dev:web",
    "install:all": "pnpm install",
    "frpc:stop": "launchctl unload ~/Library/LaunchAgents/com.frp.frpc.plist 2>/dev/null; true",
    "frpc:start": "launchctl load ~/Library/LaunchAgents/com.frp.frpc.plist",
    "build": "pnpm -F web build",
    "start": "pnpm -F server start",
    "prod": "pnpm build && pnpm start",
    "dev:frpc": "pnpm run frpc:stop && concurrently -k -n server,web,frpc -c blue,green,yellow \"pnpm run dev:server\" \"pnpm run dev:web\" \"bash scripts/frpc.sh\"",
    "prod:frpc": "pnpm build && pnpm run frpc:stop && concurrently -k -n server,frpc -c blue,yellow \"pnpm start\" \"bash scripts/frpc.sh\"",
    "deploy": "bash scripts/deploy.sh",
    "test": "pnpm -r --parallel --filter='./server' --filter='./shared' --filter='./web' run --if-present test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 --filter='./server' --filter='./shared' --filter='./web' run --if-present test:coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "coverage:diff": "node scripts/coverage-diff.mjs",
    "typecheck": "pnpm -r --parallel run --if-present typecheck",
    "typecheck:staged": "node scripts/typecheck-staged.mjs",
    "preflight:pr": "bash scripts/pr-preflight.sh",
    "test:ratchets": "node --test scripts/ratchets.test.mjs scripts/runtime-worker-rollout-order.test.mjs scripts/pr-preflight-contract.test.mjs scripts/config/effective-config.test.mjs",
    "check:ratchets": "pnpm test:ratchets && node scripts/check-max-lines-ratchet.mjs && node scripts/check-env-var-count.mjs",
    "check:web-startup-budget": "node scripts/check-web-startup-budget.mjs",
    "config:export": "node scripts/config/export-effective-config.mjs",
    "config:compare": "node scripts/config/compare-environments.mjs",
    "config:validate": "node scripts/config/validate-effective-config.mjs",
    "test:config-governance": "node --test scripts/config/effective-config.test.mjs",
    "scenarios:lint": "pnpm -F server scenarios:lint",
    "scenarios:lint:fix": "pnpm -F server scenarios:lint:fix",
    "scenarios:sanitize-check": "pnpm -F server scenarios:sanitize-check",
    "scenarios:sanitize-check:fix": "pnpm -F server scenarios:sanitize-check:fix",
    "sanitize-check": "pnpm scenarios:sanitize-check",
    "rollback": "bash scripts/rollback.sh",
    "postinstall": "patch-package",
    "prepare": "husky",
    "local:db": "docker compose -f docker-compose.local-db.yml up -d",
    "local:db:down": "docker compose -f docker-compose.local-db.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "expo": "~55.0.30",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "zustand": "^5.0.12",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
      "eslint",
      "node scripts/format-new-staged-files.mjs"
    ],
    "*.{json,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@radix-ui/react-compose-refs": "1.1.5",
      "@radix-ui/react-slot": "1.3.3",
      "axios@1.13.4": "1.18.1",
      "form-data@4.0.5": "4.0.6",
      "hono@4.11.9": "4.12.30",
      "@hono/node-server@1.19.9": "1.19.14",
      "express-rate-limit@8.2.1": "8.6.0",
      "fast-uri@3.1.0": "3.1.3",
      "lodash@4.17.23": "4.18.1",
      "path-to-regexp@0.1.12": "0.1.13",
      "path-to-regexp@8.3.0": "8.4.0",
      "qs@6.14.1": "6.15.3"
    }
  }
}
