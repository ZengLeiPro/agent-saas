{
  "name": "create-ky-app",
  "version": "0.1.0",
  "description": "开沿定制项目脚手架：生成 Hono + Vue 模板项目（含 manifest、一致性夹具与 CI）",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "templates"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-ky-app": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@kaiyan/ky-app-contract": "workspace:*"
  }
}
