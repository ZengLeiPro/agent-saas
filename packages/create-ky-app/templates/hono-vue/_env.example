# __SYSTEM_NAME__ 部署配置（§2.4）。真值只从密钥管理注入，绝不写进这个文件。
# 复制成 .env 后填写；.env 已在 .gitignore 里。

# --- KY Agent 接入（默认关闭；关闭时以下 KY_* 都不需要） ---
AGENT_INTEGRATION_ENABLED=false
KY_ENV=
KY_SYSTEM_ID=
KY_ORIGIN=
KY_DEPLOYMENT_MODE=single_tenant
KY_KEY_STORE_PROVIDER=encrypted_pg
# 部署时生成一次：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# 它只保护本业务系统自己的部署私钥，未来接入/移除组织不需要改动。
KY_DEPLOYMENT_KEY_ENCRYPTION_KEY=
KY_PLATFORM_API_BASE_URL=

# --- 仅旧 V1 系统兼容需要；V2 自动接入不要填写 ---
KY_TENANT_ID=
KY_INSTALLATION_ID=
KY_SERVICE_CREDENTIAL=
KY_INSTALLATION_KEY=
KY_INSTALLATION_KEY_VERSION=

# --- 可选：安装密钥轮换窗口（24 小时内同时接受 previous） ---
KY_INSTALLATION_KEY_PREVIOUS=
KY_INSTALLATION_KEY_PREVIOUS_VERSION=

# --- 可选：仅 KY_ENV=local|test 允许注入 ---
KY_JWKS_URL=
KY_LOCAL_LOGIN_ENABLED=
# 本地 mock 壳的 origin，会加进 CSP 的 frame-ancestors；仅 local/test 生效
KY_SHELL_ORIGIN=
# 组织目录接口基址（KY Agent 的 API 基址）
KY_DIRECTORY_URL=

# --- 本项目自身 ---
DATABASE_URL=
PORT=
