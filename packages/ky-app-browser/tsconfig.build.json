{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    // 发布产物一律全量重新 emit：增量缓存 + 手工清空 dist 会漏文件（links.js 曾因此没进 tarball）。
    "incremental": false,
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/__tests__/**"]
}
