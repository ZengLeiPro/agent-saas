{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // typecheck 走 paths 直接读兄弟包 ky-app-contract 的 src/，其中 hash.ts 用 node:crypto，
    // 因此这里需要 node 类型。发布产物（tsconfig.build.json）把 types 覆盖回 []，
    // 保证 dist 不依赖任何 Node 专属 API。
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@kaiyan/ky-app-contract": ["../ky-app-contract/src/index.ts"]
    }
  },
  "include": ["src"]
}
