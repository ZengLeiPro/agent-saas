{
  "name": "@kaiyan/ky-app-cli",
  "version": "0.1.0",
  "description": "ky-app 命令行：doctor（一致性测试与 mock 壳）、register、onboard、rotate-credential",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ky-app": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@kaiyan/ky-app-contract": "workspace:*",
    "@kaiyan/ky-app-server": "workspace:*",
    "hono": "^4.12.30",
    "jose": "^6.1.3",
    "pg": "^8.21.0"
  },
  "peerDependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
