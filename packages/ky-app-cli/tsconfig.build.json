{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // B2-13：增量缓存 + 手工清 dist 会让 tsc 跳过 emit，发布构建一律全量。
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
