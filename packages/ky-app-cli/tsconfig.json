{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@kaiyan/ky-app-contract": ["../ky-app-contract/src/index.ts"],
      "@kaiyan/ky-app-server": ["../ky-app-server/src/index.ts"],
      "@kaiyan/ky-app-server/hono": ["../ky-app-server/src/hono/index.ts"],
      "@kaiyan/ky-app-contract/browser": ["../ky-app-contract/src/browser.ts"]
    }
  },
  "include": ["src"]
}
