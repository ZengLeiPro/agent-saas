{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@agent/shared": ["../shared/src/index.ts"],
      "@agent/shared/*": ["../shared/src/*"],
      "@kaiyan/ky-app-contract": ["../packages/ky-app-contract/src/index.ts"],
      "@kaiyan/ky-app-server": ["../packages/ky-app-server/src/index.ts"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "outDir": "dist"
  },
  "include": ["src/**/*"]
}
