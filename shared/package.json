{
  "name": "@agent/shared",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests --maxWorkers=2 --coverage.processingConcurrency=2"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/governanceApi": "./src/lib/governanceApi.ts",
    "./types/governance": "./src/types/governance.ts",
    "./schemas/configIdentity": "./src/schemas/configIdentity.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zustand": "^5.0.0"
  }
}
