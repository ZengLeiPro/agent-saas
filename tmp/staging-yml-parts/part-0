name: 测试环境部署
run-name: ${{ inputs.automation_key || '测试环境部署' }}

on:
  workflow_dispatch:
    inputs:
      reason:
        description: '发版说明'
        required: false
        type: string
      promote_to_production:
        description: '通过后同步发布到生产'
        type: boolean
        default: false
        required: false

      automation_id:
        description: '内部 ID，人工留空'
        type: string
        required: false
      automation_key:
        description: '内部键，人工留空'
        type: string
        required: false

permissions:
  contents: write
  actions: read
  deployments: write
  pull-requests: read

env:
  NODE_VERSION: '22.23.1'
  AUTOMATIC_CHILD_EVIDENCE_PATH: ${{ github.workspace }}/automatic-child-authorization.jsonl
  ACR_INSTANCE_ID: cri-tapxtcyd6odwj3m4
  ACR_REPO_ID: crr-csx99pbexlsw5qqv
  ACR_REGION_ID: cn-shenzhen
  ACR_REGISTRY: agentsaasacrprod-registry-vpc.cn-shenzhen.cr.aliyuncs.com
  ACR_REPOSITORY: agent-saas/acs-sandbox

jobs:
  guard:
    name: 验证部署请求与固定的业务源码
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
      deployments: read
    outputs:
      source_sha: ${{ steps.binding.outputs.source_sha }}
      automatic: ${{ steps.binding.outputs.automatic }}
    steps:
      - uses: actions/checkout@v5
        with:
          persist-credentials: false
      - name: 在凭据分配前校验自动委派；普通人工部署仍绑定触发 SHA
        id: binding
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml

  ensure-evidence-writer:
    needs: guard
    name: 按需升级发布证据 Writer
    concurrency:
      group: staging-evidence-writer
      cancel-in-progress: false
      queue: max
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    environment: staging
    permissions:
      actions: read
      contents: read
      pull-requests: read
      deployments: read
    env:
      RELEASE_EVIDENCE_SCHEMA_VERSION: '2'
      RELEASE_EVIDENCE_SCHEMA_REVISION: '3'
      RELEASE_EVIDENCE_URL: ${{ vars.RELEASE_EVIDENCE_URL }}
      RELEASE_EVIDENCE_TOKEN: ${{ secrets.RELEASE_EVIDENCE_TOKEN }}
      ALIBABACLOUD_ACCESS_KEY_ID: ${{ secrets.ALIYUN_ACCESS_KEY_ID }}
      ALIBABACLOUD_ACCESS_KEY_SECRET: ${{ secrets.ALIYUN_ACCESS_KEY_SECRET }}
      STAGING_ECS_HOST: ${{ secrets.STAGING_ECS_HOST }}
      STAGING_ECS_USER: ${{ secrets.STAGING_ECS_USER }}
      STAGING_ECS_SSH_KEY: ${{ secrets.STAGING_ECS_SSH_KEY }}
      STAGING_SSH_HOST_KEY_SHA256: ${{ vars.STAGING_SSH_HOST_KEY_SHA256 }}

    steps:
      - name: 检出不可变触发版本
        uses: actions/checkout@v5
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
      - name: 在准备变更前重新核验自动委派
        if: inputs.automation_id != '' || inputs.automation_key != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml


      - name: 记录实际部署引擎
        run: node scripts/release/deployment-engine.mjs .github/workflows/deploy-staging.yml "$RUNNER_TEMP/deployment-engine.json"

      - name: 配置 pnpm
        uses: ./.github/actions/setup-pnpm

      - name: 配置 Node.js
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: 构建并验证 Writer 制品
        run: |
          set -euo pipefail
          pnpm install --frozen-lockfile
          node scripts/release/build-evidence-writer.mjs "$RUNNER_TEMP/writer-build"
          node scripts/release/verify-evidence-writer-bundle.mjs "$RUNNER_TEMP/writer-build/writer-build.json"
          cp "$RUNNER_TEMP/writer-build/evidence-writer.tgz" "$RUNNER_TEMP/evidence-writer.tgz"
          {
            echo "EVIDENCE_WRITER_DIGEST=$(jq -r .archiveDigest "$RUNNER_TEMP/writer-build/writer-build.json")"
            echo "EVIDENCE_WRITER_IMPLEMENTATION_DIGEST=$(jq -r .implementationDigest "$RUNNER_TEMP/writer-build/writer-build.json")"
          } >> "$GITHUB_ENV"

      - name: 判断 Writer 是否需要升级或恢复
        id: capability
        run: |
          set -euo pipefail
          : "${RELEASE_EVIDENCE_URL:?Missing RELEASE_EVIDENCE_URL}"
          : "${RELEASE_EVIDENCE_TOKEN:?Missing RELEASE_EVIDENCE_TOKEN}"
          capability_url="${RELEASE_EVIDENCE_URL%/release-evidence}/capabilities"
          status="$(curl -sS --retry 2 --connect-timeout 5 --max-time 15 \
            -o "$RUNNER_TEMP/evidence-writer-capabilities.json" -w '%{http_code}' \
            -H "authorization: Bearer $RELEASE_EVIDENCE_TOKEN" "$capability_url")" || status=000
          needs_upgrade="$(node scripts/release/evidence-writer-capability.mjs \
            "$RUNNER_TEMP/evidence-writer-capabilities.json" "$RUNNER_TEMP/writer-build/writer-build.json" "$status")"
          echo "needs_upgrade=$needs_upgrade" >> "$GITHUB_OUTPUT"
          echo "Evidence Writer implementation needs upgrade or recovery: $needs_upgrade"

      - name: 升级前确认可信 main 与 APP CI
        if: steps.capability.outputs.needs_upgrade == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          printf '%s' "$GITHUB_SHA" | grep -Eq '^[a-f0-9]{40}$'
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          git fetch --quiet --no-tags origin main
          git merge-base --is-ancestor "$GITHUB_SHA" origin/main
          workflow_id="$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml" --jq .id)"
          app_ci_run=''
          for attempt in $(seq 1 180); do
            app_ci_run="$(gh api --method GET \
              "repos/$GITHUB_REPOSITORY/actions/workflows/$workflow_id/runs" \
              -f branch=main -f head_sha="$GITHUB_SHA" -f event=push -f per_page=20 \
              --jq '[.workflow_runs[] | select(.head_sha == env.GITHUB_SHA and .head_branch == "main" and .event == "push")] | sort_by(.run_number) | last // empty')"
            if [ -n "$app_ci_run" ] && [ "$(printf '%s' "$app_ci_run" | jq -r .status)" = completed ]; then
              test "$(printf '%s' "$app_ci_run" | jq -r .conclusion)" = success
              break
            fi
            if [ "$attempt" -eq 180 ]; then
              echo 'Timed out waiting for the trusted main APP CI run' >&2
              exit 1
            fi
            sleep 10
          done
          app_ci_run_id="$(printf '%s' "$app_ci_run" | jq -r .id)"
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$app_ci_run_id" \
            > "$RUNNER_TEMP/app-ci-run.json"
          jq -e --arg sha "$GITHUB_SHA" --argjson workflow_id "$workflow_id" '
            .workflow_id == $workflow_id and .event == "push" and
            .head_branch == "main" and .head_sha == $sha and
            .status == "completed" and .conclusion == "success"
          ' "$RUNNER_TEMP/app-ci-run.json" >/dev/null
          gh api -H 'Accept: application/vnd.github+json' \
            "repos/$GITHUB_REPOSITORY/commits/$GITHUB_SHA/pulls" \
            > "$RUNNER_TEMP/associated-pulls.json"
          jq -e --arg sha "$GITHUB_SHA" '
            map(select(.state == "closed" and .merged_at != null and
              .base.ref == "main" and .merge_commit_sha == $sha)) |
            if length == 1 then .[0] else error("Expected exactly one merged PR") end
          ' "$RUNNER_TEMP/associated-pulls.json" >/dev/null

      - name: 安装阿里云 CLI
        if: steps.capability.outputs.needs_upgrade == 'true'
        run: |
          set -euo pipefail
          bash scripts/release/install-aliyun-cli.sh

      - name: 为当前 Runner 授权测试环境 SSH
        if: steps.capability.outputs.needs_upgrade == 'true'
        run: |
          set -euo pipefail
          runner_ip="$(curl -4 -fsS --retry 5 https://api.ipify.org)"
          node -e "if (!require('node:net').isIPv4(process.argv[1])) process.exit(1)" "$runner_ip"
          security_group_id="$(jq -r .resources.api.securityGroupId infra/staging/resource-plan.json)"
          printf '%s' "$security_group_id" | grep -Eq '^sg-[a-z0-9]+$'
          source_cidr="$runner_ip/32"
          {
            echo "STAGING_SSH_SECURITY_GROUP_ID=$security_group_id"
            echo "STAGING_SSH_SOURCE_CIDR=$source_cidr"
          } >> "$GITHUB_ENV"
          aliyun --region cn-shenzhen ecs AuthorizeSecurityGroup \
            --RegionId cn-shenzhen --SecurityGroupId "$security_group_id" \
            --IpProtocol TCP --PortRange 22/22 --SourceCidrIp "$source_cidr" \
            --Policy accept --Priority 1 \
            --Description "GitHub Evidence Writer SSH $GITHUB_RUN_ID/$GITHUB_RUN_ATTEMPT" \
            --ClientToken "evidence-writer-ssh-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >/dev/null

      - name: 配置固定的 Staging SSH
        if: steps.capability.outputs.needs_upgrade == 'true'
        run: |
          set -euo pipefail
          : "${STAGING_ECS_HOST:?Missing STAGING_ECS_HOST}"
          : "${STAGING_ECS_USER:?Missing STAGING_ECS_USER}"
          : "${STAGING_ECS_SSH_KEY:?Missing STAGING_ECS_SSH_KEY}"
          : "${STAGING_SSH_HOST_KEY_SHA256:?Missing STAGING_SSH_HOST_KEY_SHA256}"
          install -d -m 0700 ~/.ssh
          printf '%s\n' "$STAGING_ECS_SSH_KEY" > ~/.ssh/staging_key
          chmod 0600 ~/.ssh/staging_key
          for attempt in $(seq 1 5); do
            if ssh-keyscan -T 10 -t ed25519 -H "$STAGING_ECS_HOST" \
              > "$RUNNER_TEMP/staging-known-host"; then break; fi
            test "$attempt" -lt 5
            sleep 2
          done
          test -s "$RUNNER_TEMP/staging-known-host"
          test "$(ssh-keygen -lf "$RUNNER_TEMP/staging-known-host" -E sha256 | awk '{print $2}')" = \
            "$STAGING_SSH_HOST_KEY_SHA256"
          cat "$RUNNER_TEMP/staging-known-host" >> ~/.ssh/known_hosts

      - name: 原子升级并验证 Writer前重新核对父请求
        if: steps.capability.outputs.needs_upgrade == 'true' && inputs.automation_id != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml

      - name: 原子升级并验证 Writer
        if: steps.capability.outputs.needs_upgrade == 'true'
        run: |
          set -euo pipefail
          remote="/tmp/evidence-writer-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cleanup() {
            ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
              "rm -rf -- '$remote'"
          }
          trap cleanup EXIT
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" "mkdir -p '$remote'"
          git rev-list "$GITHUB_SHA" > "$RUNNER_TEMP/writer-ancestors.txt"
          scp -i ~/.ssh/staging_key "$RUNNER_TEMP/evidence-writer.tgz" "$RUNNER_TEMP/writer-ancestors.txt" \
            scripts/release/deploy-evidence-writer.sh \
            "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "bash '$remote/deploy-evidence-writer.sh' '$remote/evidence-writer.tgz' '$EVIDENCE_WRITER_DIGEST' '$GITHUB_SHA' '$RELEASE_EVIDENCE_SCHEMA_VERSION' '$RELEASE_EVIDENCE_SCHEMA_REVISION' '$EVIDENCE_WRITER_IMPLEMENTATION_DIGEST' '$remote/writer-ancestors.txt'"
          status="$(curl -sS --retry 5 --retry-all-errors --connect-timeout 10 --max-time 30 \
            -o "$RUNNER_TEMP/capabilities-after.json" -w '%{http_code}' \
            -H "authorization: Bearer $RELEASE_EVIDENCE_TOKEN" \
            "${RELEASE_EVIDENCE_URL%/release-evidence}/capabilities")"
          test "$status" = 200
          jq -e --argjson version "$RELEASE_EVIDENCE_SCHEMA_VERSION" \
            --argjson revision "$RELEASE_EVIDENCE_SCHEMA_REVISION" \
            --arg implementationDigest "$EVIDENCE_WRITER_IMPLEMENTATION_DIGEST" '
              .service == "agent-saas-release-evidence" and
              .currentReleaseEvidenceSchemaVersion == $version and
              .releaseEvidenceSchemaRevision >= $revision and
              .implementationDigest == $implementationDigest
            ' "$RUNNER_TEMP/capabilities-after.json" >/dev/null

      - name: 撤销临时测试环境 SSH 入站授权
        if: always() && env.STAGING_SSH_SOURCE_CIDR != ''
        run: |
          set -euo pipefail
          for attempt in 1 2 3 4 5; do
            if aliyun --region cn-shenzhen ecs RevokeSecurityGroup \
              --RegionId cn-shenzhen --SecurityGroupId "$STAGING_SSH_SECURITY_GROUP_ID" \
              --IpProtocol TCP --PortRange 22/22 --SourceCidrIp "$STAGING_SSH_SOURCE_CIDR" \
              --Policy accept --Priority 1 >/dev/null; then
              exit 0
            fi
            test "$attempt" -lt 5
            sleep 2
          done

  prepare-evidence:
    name: 准备发布证据
    outputs:
      app_ci_run_id: ${{ steps.trusted_ci.outputs.run_id }}
      app_ci_run_attempt: ${{ steps.trusted_ci.outputs.run_attempt }}
      source_sha: ${{ needs.guard.outputs.source_sha }}
      automatic: ${{ needs.guard.outputs.automatic }}
      evidence_artifact_id: ${{ steps.fresh_authority.outputs.artifact-id }}
    needs: [ensure-evidence-writer, guard]
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    environment: production
    permissions:
      actions: read
      contents: read
      pull-requests: read
      deployments: read
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
      ECS_HOST: ${{ secrets.ECS_HOST }}
      ECS_USER: ${{ secrets.ECS_USER }}
      ECS_SSH_KEY: ${{ secrets.ECS_SSH_KEY }}
      PRODUCTION_SSH_HOST_KEY_SHA256: ${{ vars.PRODUCTION_SSH_HOST_KEY_SHA256 }}
      RELEASE_RECORD_OSS_URI: ${{ vars.RELEASE_RECORD_OSS_URI }}
      RELEASE_RECORD_OSS_REGION: ${{ vars.RELEASE_RECORD_OSS_REGION }}
      ALIBABACLOUD_ACCESS_KEY_ID: ${{ secrets.ALIYUN_ACCESS_KEY_ID }}
      ALIBABACLOUD_ACCESS_KEY_SECRET: ${{ secrets.ALIYUN_ACCESS_KEY_SECRET }}
      RELEASE_EVIDENCE_SCHEMA_VERSION: '2'
      RELEASE_EVIDENCE_SCHEMA_REVISION: '3'
      RELEASE_SHA: ${{ needs.guard.outputs.source_sha }}
      AUTOMATIC_RELEASE: ${{ needs.guard.outputs.automatic }}
      PRODUCTION_CONFIG_IDENTITY_STAGE: steady-state

    steps:
      - name: 校验证据写入器配置
        env:
          PRODUCTION_OBSERVATION_URL: ${{ vars.PRODUCTION_OBSERVATION_URL }}
          RELEASE_EVIDENCE_READ_TOKEN: ${{ secrets.PRODUCTION_OBSERVATION_TOKEN }}
          RELEASE_EVIDENCE_WRITE_TOKEN: ${{ secrets.RELEASE_EVIDENCE_WRITE_TOKEN }}
        run: |
          set -euo pipefail
          : "${PRODUCTION_OBSERVATION_URL:?Missing production variable PRODUCTION_OBSERVATION_URL}"
          : "${RELEASE_EVIDENCE_READ_TOKEN:?Missing production Evidence read token}"
          : "${RELEASE_EVIDENCE_WRITE_TOKEN:?Missing production Evidence write token}"
          test "$RELEASE_EVIDENCE_READ_TOKEN" != "$RELEASE_EVIDENCE_WRITE_TOKEN"
          case "$PRODUCTION_OBSERVATION_URL" in
            https://*/production-observation) ;;
            *) echo 'PRODUCTION_OBSERVATION_URL must be HTTPS and end with /production-observation' >&2; exit 1 ;;
          esac

      - name: 校验证据写入器架构兼容性
        env:
          PRODUCTION_OBSERVATION_URL: ${{ vars.PRODUCTION_OBSERVATION_URL }}
          RELEASE_EVIDENCE_READ_TOKEN: ${{ secrets.PRODUCTION_OBSERVATION_TOKEN }}
        run: |
          set -euo pipefail
          capability_url="${PRODUCTION_OBSERVATION_URL%/production-observation}/capabilities"
          status="$(curl -sS --retry 3 --connect-timeout 10 --max-time 30 \
            -o "$RUNNER_TEMP/evidence-writer-capabilities.json" -w '%{http_code}' \
            -H "authorization: Bearer $RELEASE_EVIDENCE_READ_TOKEN" \
            "$capability_url")"
          if [ "$status" != 200 ]; then
            cat "$RUNNER_TEMP/evidence-writer-capabilities.json" >&2
            echo "Evidence Writer capability check failed with HTTP $status" >&2
            exit 1
          fi
          if ! jq -e --argjson required "$RELEASE_EVIDENCE_SCHEMA_VERSION" \
            --argjson requiredRevision "$RELEASE_EVIDENCE_SCHEMA_REVISION" '
            .schemaVersion == 1 and
            .service == "agent-saas-release-evidence" and
            .releaseEvidenceSchemaRevision >= $requiredRevision and
            (.currentReleaseEvidenceSchemaVersion | type == "number") and
            (.supportedReleaseEvidenceSchemaVersions | type == "array") and
            (.supportedReleaseEvidenceSchemaVersions | index($required) != null)
          ' "$RUNNER_TEMP/evidence-writer-capabilities.json" >/dev/null; then
            cat "$RUNNER_TEMP/evidence-writer-capabilities.json" >&2
            echo "Evidence Writer does not support required Release Evidence schema v$RELEASE_EVIDENCE_SCHEMA_VERSION revision $RELEASE_EVIDENCE_SCHEMA_REVISION" >&2
            exit 1
          fi

      - name: 检出用于生成证据的不可变触发版本
        uses: actions/checkout@v5
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
      - name: 在准备变更前重新核验自动委派
        if: inputs.automation_id != '' || inputs.automation_key != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml


      - name: 配置 pnpm
        uses: ./.github/actions/setup-pnpm
      - name: 配置 Node.js
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm
      - name: 安装依赖
        run: pnpm install --frozen-lockfile

      - name: 等待应用 CI 成功并校验已合并的 GitHub PR
        id: trusted_ci
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          printf '%s' "$RELEASE_SHA" | grep -Eq '^[a-f0-9]{40}$'
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          git cat-file -e "$RELEASE_SHA^{commit}"
          git fetch --quiet --no-tags origin main
          git merge-base --is-ancestor "$RELEASE_SHA" origin/main

          # Workflow 显示名称会随侧边栏排序调整；发布门禁只绑定稳定的文件身份与数值 ID。
          gh api "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml" \
            > "$RUNNER_TEMP/app-ci-workflow.json"
          jq -e '
            (.id | type == "number" and . > 0) and
            .path == ".github/workflows/ci.yml"
          ' "$RUNNER_TEMP/app-ci-workflow.json" >/dev/null
          app_ci_workflow_id="$(jq -r .id "$RUNNER_TEMP/app-ci-workflow.json")"

          app_ci_run=''
          app_ci_ready=false
          for attempt in $(seq 1 180); do
            gh api --method GET \
              "repos/$GITHUB_REPOSITORY/actions/workflows/$app_ci_workflow_id/runs" \
              -f branch=main -f head_sha="$RELEASE_SHA" -f event=push -f per_page=20 \
              > "$RUNNER_TEMP/app-ci-runs.json"
            app_ci_run="$(jq -c --arg sha "$RELEASE_SHA" \
              --argjson workflow_id "$app_ci_workflow_id" '
              [.workflow_runs[] | select(
                .workflow_id == $workflow_id and
                .head_sha == $sha and
                .head_branch == "main" and
                .event == "push"
              )] |
              sort_by(.run_number) | last // empty
            ' "$RUNNER_TEMP/app-ci-runs.json")"
            if [ -z "$app_ci_run" ]; then
              if [ "$attempt" -eq 1 ] || [ $((attempt % 6)) -eq 0 ]; then
                echo "等待 APP CI：尚未找到同一 SHA 的 main push run（$attempt/180）"
              fi
              sleep 10
              continue
            fi

            app_ci_run_id="$(printf '%s' "$app_ci_run" | jq -r .id)"
            app_ci_status="$(printf '%s' "$app_ci_run" | jq -r .status)"
            app_ci_conclusion="$(printf '%s' "$app_ci_run" | jq -r '.conclusion // "pending"')"
            if [ "$app_ci_status" != completed ]; then
              if [ "$attempt" -eq 1 ] || [ $((attempt % 6)) -eq 0 ]; then
                echo "等待 APP CI run $app_ci_run_id：status=$app_ci_status（$attempt/180）"
              fi
              sleep 10
              continue
            fi

            if [ "$app_ci_conclusion" != success ]; then
              printf '%s' "$app_ci_run" | jq '{
                id, workflow_id, name, event, head_branch, head_sha,
                status, conclusion, run_number, run_attempt, html_url
              }' >&2
              echo "::error::APP CI run $app_ci_run_id 已完成，但结论为 $app_ci_conclusion" >&2
              exit 1
            fi
            app_ci_ready=true
            break
          done

          if [ "$app_ci_ready" != true ]; then
            echo "::error::等待 APP CI 超时：workflow_id=$app_ci_workflow_id sha=$RELEASE_SHA" >&2
            if [ -n "$app_ci_run" ]; then
              printf '%s' "$app_ci_run" | jq '{
                id, workflow_id, name, event, head_branch, head_sha,
                status, conclusion, run_number, run_attempt, html_url
              }' >&2
            else
              jq --arg sha "$RELEASE_SHA" '[
                .workflow_runs[