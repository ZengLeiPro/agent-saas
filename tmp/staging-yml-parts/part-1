] | select(.head_sha == $sha) | {
                  id, workflow_id, name, event, head_branch, head_sha,
                  status, conclusion, run_number, run_attempt, html_url
                }
              ]' "$RUNNER_TEMP/app-ci-runs.json" >&2
            fi
            exit 1
          fi

          printf '%s' "$app_ci_run_id" | grep -Eq '^[0-9]+$'

          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$app_ci_run_id" \
            > "$RUNNER_TEMP/app-ci-run.json"
          jq -e --arg sha "$RELEASE_SHA" \
            --argjson workflow_id "$app_ci_workflow_id" '
            .workflow_id == $workflow_id and
            .event == "push" and
            .head_branch == "main" and
            .head_sha == $sha and
            .status == "completed" and
            .conclusion == "success"
          ' "$RUNNER_TEMP/app-ci-run.json" >/dev/null
          echo "APP_CI_RUN_ID=$app_ci_run_id" >> "$GITHUB_ENV"
          echo "run_id=$app_ci_run_id" >> "$GITHUB_OUTPUT"
          echo "run_attempt=$(jq -r .run_attempt "$RUNNER_TEMP/app-ci-run.json")" >> "$GITHUB_OUTPUT"
          echo "已验证 APP CI run $app_ci_run_id"

          gh api -H 'Accept: application/vnd.github+json' \
            "repos/$GITHUB_REPOSITORY/commits/$RELEASE_SHA/pulls" \
            > "$RUNNER_TEMP/associated-pulls.json"
          jq -e --arg sha "$RELEASE_SHA" '
            map(select(
              .state == "closed" and
              .merged_at != null and
              .base.ref == "main" and
              .merge_commit_sha == $sha
            )) |
            if length == 1 then .[0] else error("Expected exactly one merged PR for Release SHA") end
          ' "$RUNNER_TEMP/associated-pulls.json" > "$RUNNER_TEMP/release-pr.json"
          jq -e '.number > 0 and (.head.sha | test("^[a-f0-9]{40}$"))' \
            "$RUNNER_TEMP/release-pr.json" >/dev/null
          jq '{
            schemaVersion: 1,
            finalPullRequest: {
              number: .number,
              headSha: .head.sha,
              mergeCommitOid: .merge_commit_sha,
              state: "MERGED"
            },
            sources: []
          }' "$RUNNER_TEMP/release-pr.json" > "$RUNNER_TEMP/merge.json"

      - name: 解析同一发布 SHA 的 ACS 证据
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          # ci.yml now owns both gates. Never wait for the manual ACS deployment workflow.
          # Read every latest-job page; successful jobs from earlier rerun attempts remain valid.
          gh api --paginate --slurp \
            "repos/$GITHUB_REPOSITORY/actions/runs/$APP_CI_RUN_ID/jobs?filter=latest&per_page=100" \
            > "$RUNNER_TEMP/unified-ci-jobs-pages.json"
          # Reject a rerun that raced the trusted CI read and job collection.
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$APP_CI_RUN_ID" \
            > "$RUNNER_TEMP/unified-ci-run.json"
          node scripts/release/unified-ci-evidence.mjs \
            "$RUNNER_TEMP/app-ci-workflow.json" "$RUNNER_TEMP/app-ci-run.json" \
            "$RUNNER_TEMP/unified-ci-jobs-pages.json" "$RUNNER_TEMP/unified-ci-run.json" \
            "$RELEASE_SHA" "$GITHUB_REPOSITORY" > "$RUNNER_TEMP/checks.json"

      - name: 存在时复用不可变发布证据
        if: env.AUTOMATIC_RELEASE != 'true'
        env:
          PRODUCTION_OBSERVATION_URL: ${{ vars.PRODUCTION_OBSERVATION_URL }}
          RELEASE_EVIDENCE_READ_TOKEN: ${{ secrets.PRODUCTION_OBSERVATION_TOKEN }}
        run: |
          set -euo pipefail
          release_evidence_url="$(node - <<'NODE'
          const value = new URL(process.env.PRODUCTION_OBSERVATION_URL);
          if (!value.pathname.endsWith('/production-observation')) {
            throw new Error('PRODUCTION_OBSERVATION_URL must end with /production-observation');
          }
          value.pathname = value.pathname.replace(/\/production-observation$/u, '/release-evidence');
          process.stdout.write(value.toString());
          NODE
          )"
          status="$(curl -sS --retry 3 -o "$RUNNER_TEMP/existing-release-evidence.json" \
            -w '%{http_code}' -H "authorization: Bearer $RELEASE_EVIDENCE_READ_TOKEN" \
            "$release_evidence_url?sha=$RELEASE_SHA")"
          case "$status" in
            200)
              node --input-type=module -e "
                import { readFile } from 'node:fs/promises';
                import { validateReleaseEvidenceDocument } from './scripts/release/release-evidence-schema.mjs';
                const evidence = JSON.parse(await readFile(process.argv[1], 'utf8'));
                validateReleaseEvidenceDocument(evidence, { expectedSha: process.argv[2] });
              " "$RUNNER_TEMP/existing-release-evidence.json" "$RELEASE_SHA"
              echo 'REUSE_RELEASE_EVIDENCE=true' >> "$GITHUB_ENV"
              {
                echo '### Immutable Release Evidence'
                echo
                echo "- Release SHA: \`$RELEASE_SHA\`"
                echo "- Evidence digest: \`$(jq -r .evidenceDigest "$RUNNER_TEMP/existing-release-evidence.json")\`"
                echo '- Result: reused existing immutable evidence after schema validation'
              } >> "$GITHUB_STEP_SUMMARY"
              ;;
            404)
              echo 'REUSE_RELEASE_EVIDENCE=false' >> "$GITHUB_ENV"
              ;;
            *)
              cat "$RUNNER_TEMP/existing-release-evidence.json" >&2
              echo "Release Evidence read failed with HTTP $status" >&2
              exit 1
              ;;
          esac

      - name: 配置固定的生产只读 SSH
        if: env.REUSE_RELEASE_EVIDENCE != 'true'
        run: |
          set -euo pipefail
          : "${ECS_HOST:?Missing production secret ECS_HOST}"
          : "${ECS_USER:?Missing production secret ECS_USER}"
          : "${ECS_SSH_KEY:?Missing production secret ECS_SSH_KEY}"
          : "${PRODUCTION_SSH_HOST_KEY_SHA256:?Missing pinned Production SSH host key fingerprint}"
          mkdir -p ~/.ssh && chmod 700 ~/.ssh
          printf '%s\n' "$ECS_SSH_KEY" > ~/.ssh/production_evidence_key
          chmod 600 ~/.ssh/production_evidence_key
          ssh-keyscan -t ed25519 -H "$ECS_HOST" > "$RUNNER_TEMP/production-known-host"
          test "$(ssh-keygen -lf "$RUNNER_TEMP/production-known-host" -E sha256 | awk '{print $2}')" = \
            "$PRODUCTION_SSH_HOST_KEY_SHA256"
          cat "$RUNNER_TEMP/production-known-host" >> ~/.ssh/known_hosts

      - name: 只读获取在线生产状态
        if: env.REUSE_RELEASE_EVIDENCE != 'true'
        run: |
          set -euo pipefail
          remote="/tmp/release-evidence-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cleanup() {
            ssh -i ~/.ssh/production_evidence_key "$ECS_USER@$ECS_HOST" "rm -rf -- '$remote'"
          }
          trap cleanup EXIT
          ssh -i ~/.ssh/production_evidence_key "$ECS_USER@$ECS_HOST" "mkdir -p '$remote'"
          scp -i ~/.ssh/production_evidence_key scripts/release/production-preflight.mjs \
            scripts/release/production-preflight-report.mjs scripts/release/production-runtime-observation.mjs \
            scripts/release/read-production-state.mjs \
            scripts/release/read-runtime-identity.mjs scripts/release/config-publication.mjs scripts/release/artifact-lib.mjs \
            scripts/release/production-checkpoint.mjs "$ECS_USER@$ECS_HOST:$remote/"
          baseline_source=live
          if ! bash scripts/release/run-production-preflight.sh "$remote" ~/.ssh/production_evidence_key \
            read-production-state.mjs "$PRODUCTION_CONFIG_IDENTITY_STAGE" production.json fresh \
            2> "$RUNNER_TEMP/production-live-observation-error.log"; then
            if [ "$AUTOMATIC_RELEASE" = true ]; then
              echo 'Automatic refresh requires a live production baseline; checkpoint fallback is not allowed' >&2
              exit 1
            fi
            baseline_source=last_committed
            echo '::warning title=Production preflight failed::Using last_committed as a historical build baseline only; current production readiness has NOT passed.'
            ssh -i ~/.ssh/production_evidence_key "$ECS_USER@$ECS_HOST" \
              "sudo node '$remote/production-checkpoint.mjs' baseline --checkpoint /etc/agent-saas/last-committed-production.json --output '$remote/production.json'"
          fi
          ssh -i ~/.ssh/production_evidence_key "$ECS_USER@$ECS_HOST" \
            "sudo cat '$remote/production.json'" > "$RUNNER_TEMP/production.json"
          test "$(jq -r .environment "$RUNNER_TEMP/production.json")" = production
          node scripts/release/production-preflight-report.mjs baseline \
            "$RUNNER_TEMP/production-baseline-provenance.json" "$baseline_source" "$RUNNER_TEMP/production.json" \
            | tee -a "$GITHUB_STEP_SUMMARY"
          if [ "$baseline_source" = last_committed ]; then
            echo '**Production preflight failed. Staging may validate a candidate built against historical evidence; production promotion remains blocked until a fresh strict preflight passes.**' >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: 安装用于生产证据的阿里云 CLI
        if: env.REUSE_RELEASE_EVIDENCE != 'true'
        run: |
          set -euo pipefail
          bash scripts/release/install-aliyun-cli.sh

      - name: 将不可变 OSS 产物绑定到在线生产环境
        if: env.REUSE_RELEASE_EVIDENCE != 'true'
        run: |
          set -euo pipefail
          : "${ALIBABACLOUD_ACCESS_KEY_ID:?Missing production secret ALIYUN_ACCESS_KEY_ID}"
          : "${ALIBABACLOUD_ACCESS_KEY_SECRET:?Missing production secret ALIYUN_ACCESS_KEY_SECRET}"
          : "${RELEASE_RECORD_OSS_URI:?Missing production variable RELEASE_RECORD_OSS_URI}"
          : "${RELEASE_RECORD_OSS_REGION:?Missing production variable RELEASE_RECORD_OSS_REGION}"
          case "$RELEASE_RECORD_OSS_URI" in oss://*) ;; *) exit 1 ;; esac
          case "$RELEASE_RECORD_OSS_REGION" in cn-*) ;; *) exit 1 ;; esac
          node scripts/release/fetch-baseline-artifacts.mjs "$RUNNER_TEMP/production.json" \
            "$RELEASE_RECORD_OSS_URI" "$RELEASE_RECORD_OSS_REGION" "$RUNNER_TEMP/baseline-artifacts.json"

      - name: 生成、发布并回读不可变发布证据
        if: env.REUSE_RELEASE_EVIDENCE != 'true'
        env:
          PRODUCTION_OBSERVATION_URL: ${{ vars.PRODUCTION_OBSERVATION_URL }}
          RELEASE_EVIDENCE_READ_TOKEN: ${{ secrets.PRODUCTION_OBSERVATION_TOKEN }}
          RELEASE_EVIDENCE_WRITE_TOKEN: ${{ secrets.RELEASE_EVIDENCE_WRITE_TOKEN }}
        run: |
          set -euo pipefail
          baseline="$(jq -r .components.api.gitSha "$RUNNER_TEMP/production.json")"
          git cat-file -e "$baseline^{commit}"
          git merge-base --is-ancestor "$baseline" "$RELEASE_SHA"
          if ! node scripts/release/classify-components.mjs \
            --baseline "$baseline" --target "$RELEASE_SHA" \
            > "$RUNNER_TEMP/classification.json"; then
            cat "$RUNNER_TEMP/classification.json" >&2
            exit 1
          fi
          if ! node scripts/release/migration-plan.mjs \
            --changed-paths "$RUNNER_TEMP/classification.json" \
            --baseline "$baseline" --target "$RELEASE_SHA" \
            > "$RUNNER_TEMP/migration.json"; then
            cat "$RUNNER_TEMP/migration.json" >&2
            exit 1
          fi
          node scripts/release/produce-release-evidence.mjs \
            --sha "$RELEASE_SHA" \
            --merge "$RUNNER_TEMP/merge.json" \
            --checks "$RUNNER_TEMP/checks.json" \
            --production "$RUNNER_TEMP/production.json" \
            --baseline-artifacts "$RUNNER_TEMP/baseline-artifacts.json" \
            --classification "$RUNNER_TEMP/classification.json" \
            --migration "$RUNNER_TEMP/migration.json" \
            --output "$RUNNER_TEMP/release-evidence.json"

          release_evidence_url="$(node - <<'NODE'
          const value = new URL(process.env.PRODUCTION_OBSERVATION_URL);
          if (!value.pathname.endsWith('/production-observation')) {
            throw new Error('PRODUCTION_OBSERVATION_URL must end with /production-observation');
          }
          value.pathname = value.pathname.replace(/\/production-observation$/u, '/release-evidence');
          process.stdout.write(value.toString());
          NODE
          )"
          if [ "$AUTOMATIC_RELEASE" = true ]; then
            cp "$RUNNER_TEMP/release-evidence.json" "$RUNNER_TEMP/authoritative-evidence.json"
            test "$(jq -r '.baselineObservation // empty' "$RUNNER_TEMP/authoritative-evidence.json")" = ''
          else
            node scripts/release/publish-release-evidence.mjs \
              --input "$RUNNER_TEMP/release-evidence.json" \
              --url "$release_evidence_url"
          fi

          {
            echo '### Immutable Release Evidence'
            echo
            echo "- Release SHA: \`$RELEASE_SHA\`"
            echo "- Evidence digest: \`$(jq -r .evidenceDigest "$RUNNER_TEMP/release-evidence.json")\`"
            echo "- Release PR: #$(jq -r .finalPullRequest.number "$RUNNER_TEMP/merge.json")"
            echo "- Result: generated; automatic=$AUTOMATIC_RELEASE (automatic authority is archived per run; manual authority uses Writer readback)"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: 保存本次自动刷新独立的权威证据（不覆盖旧 SHA 记录）
        if: env.AUTOMATIC_RELEASE == 'true'
        id: fresh_authority
        uses: actions/upload-artifact@v7
        with:
          name: automatic-authority-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/authoritative-evidence.json
          if-no-files-found: error
          retention-days: 90

      - name: 上传生产基线观测诊断
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: production-baseline-observation-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: ignore
          retention-days: 14
          path: |
            ${{ runner.temp }}/production-live-observation-error.log
            ${{ runner.temp }}/production-preflight*.json
            ${{ runner.temp }}/production-baseline-provenance.json

  prepare-acs:
    name: 准备精确 ACS 镜像（含自动恢复）
    needs: prepare-evidence
    concurrency:
      group: acr-image-${{ needs.prepare-evidence.outputs.source_sha }}
      cancel-in-progress: false
      queue: max
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    environment: staging
    permissions:
      actions: read
      contents: read
      deployments: read
    env:
      RELEASE_SOURCE_SHA: ${{ needs.prepare-evidence.outputs.source_sha }}
      AUTOMATIC_RELEASE: ${{ needs.prepare-evidence.outputs.automatic }}
    outputs:
      include_acs: ${{ steps.image.outputs.include_acs }}
      artifact_name: ${{ steps.image.outputs.artifact_name }}
    steps:
      - name: 检出不可变触发版本
        uses: actions/checkout@v5
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
      - name: 在准备变更前重新核验自动委派
        if: inputs.automation_id != '' || inputs.automation_key != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml

      - name: 配置 Node.js
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}
          # This dependency-free job runs only Node/Python CLI scripts.
          package-manager-cache: false
      - name: 读取同一次自动刷新生成的独立权威证据
        if: needs.prepare-evidence.outputs.automatic == 'true'
        uses: actions/download-artifact@v7
        with:
          artifact-ids: ${{ needs.prepare-evidence.outputs.evidence_artifact_id }}
          path: ${{ runner.temp }}
          merge-multiple: true
      - name: 安装阿里云 CLI
        run: |
          set -euo pipefail
          curl -fsSL --connect-timeout 10 --max-time 120 https://aliyuncli.alicdn.com/aliyun-cli-linux-latest-amd64.tgz -o "$RUNNER_TEMP/aliyun.tgz"
          tar xzf "$RUNNER_TEMP/aliyun.tgz" -C "$RUNNER_TEMP"
          sudo install "$RUNNER_TEMP/aliyun" /usr/local/bin/aliyun
      - name: 等待并按需恢复精确镜像
        id: image
        timeout-minutes: 46
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_EVIDENCE_URL: ${{ vars.RELEASE_EVIDENCE_URL }}
          RELEASE_EVIDENCE_TOKEN: ${{ secrets.RELEASE_EVIDENCE_TOKEN }}
          ALIBABACLOUD_ACCESS_KEY_ID: ${{ secrets.ACR_READ_ACCESS_KEY_ID }}
          ALIBABACLOUD_ACCESS_KEY_SECRET: ${{ secrets.ACR_READ_ACCESS_KEY_SECRET }}
          STAGING_RELEASE_OSS_URI: ${{ vars.STAGING_RELEASE_OSS_URI }}
          RELEASE_RECORD_OSS_URI: ${{ vars.RELEASE_RECORD_OSS_URI }}
          RELEASE_RECORD_OSS_REGION: cn-shenzhen
          ACR_WEBHOOK_REDELIVERY_TOKEN: ${{ secrets.ACS_WEBHOOK_REDELIVERY_TOKEN }}
          # Reuse the existing ACS workflow binding; allow an explicit rotation.
          ACR_GITHUB_HOOK_ID: ${{ vars.ACR_GITHUB_HOOK_ID || '649018221' }}
        run: |
          set -euo pipefail
          created_at="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" --jq .created_at)"
          release_date="${created_at:0:10}"
          release_id="rc-${release_date//-/}-$(printf '%02d' "$GITHUB_RUN_NUMBER")"
          echo "artifact_name=prepared-acs-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
          echo 'include_acs=false' >> "$GITHUB_OUTPUT"
          # Existing RCs are validated and reused by the deployment job, never rebuilt.
          record_uri="${STAGING_RELEASE_OSS_URI:-${RELEASE_RECORD_OSS_URI:-}}/records/$release_id"
          if [ -n "${STAGING_RELEASE_OSS_URI:-${RELEASE_RECORD_OSS_URI:-}}" ] \
            && aliyun --secure oss stat "$record_uri/manifest.json" \
              --region "${RELEASE_RECORD_OSS_REGION:-cn-shenzhen}" >/dev/null 2>&1; then
            exit 0
          fi
          if gh release view "$release_id" >/dev/null 2>&1; then exit 0; fi
          if [ "$AUTOMATIC_RELEASE" = true ]; then
            cp "$RUNNER_TEMP/authoritative-evidence.json" "$RUNNER_TEMP/acs-authority.json"
          else
            curl -fsS --connect-timeout 10 --max-time 60 --retry 2 \
              -H "authorization: Bearer $RELEASE_EVIDENCE_TOKEN" \
              "$RELEASE_EVIDENCE_URL?sha=$RELEASE_SOURCE_SHA" > "$RUNNER_TEMP/acs-authority.json"
          fi
          jq -e --arg sha "$RELEASE_SOURCE_SHA" '.ok == true and .releaseSha == $sha and (.affectedComponents | type == "array")' "$RUNNER_TEMP/acs-authority.json" >/dev/null
          if jq -e '.affectedComponents | index("acs") != null' "$RUNNER_TEMP/acs-authority.json" >/dev/null; then
            RELEASE_SHA="$RELEASE_SOURCE_SHA" OUTPUT_FILE="$RUNNER_TEMP/acs-image-prepared.json" \
              bash scripts/release/wait-for-acr-image.sh
            echo 'include_acs=true' >> "$GITHUB_OUTPUT"
          fi
      - name: 保存同一次运行的已验证镜像与诊断
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: prepared-acs-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: ignore
          retention-days: 14
          path: |
            ${{ runner.temp }}/acs-image-prepared.json
            ${{ runner.temp }}/acr-recovery-report.json

  promote-production:
    name: 自动触发生产环境发布
    needs: build-deploy-verify
    if: success() && github.ref == 'refs/heads/main' && inputs.promote_to_production == true
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      actions: write
    env:
      RELEASE_ID: ${{ needs.build-deploy-verify.outputs.release_id }}
      DISPATCH_REASON: ${{ inputs.reason || 'manual staging release' }}
    steps:
      - name: 触发「生产环境发布」发布本次 RC
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          [[ "$RELEASE_ID" =~ ^rc-[0-9]{8}-[0-9]{2,}$ ]]
          reason="测试环境部署 #$GITHUB_RUN_NUMBER 通过后自动发布：$DISPATCH_REASON"
          for attempt in 1 2 3; do
            # 本 job 无 checkout。gh 默认用 git remote 认仓，必须显式 --repo。
            if gh workflow run promote-release.yml --repo "$GITHUB_REPOSITORY" --ref main \
              -f operation=promote -f release_id="$RELEASE_ID" -f reason="$reason"; then
              echo "已触发「生产环境发布」：$RELEASE_ID" >> "$GITHUB_STEP_SUMMARY"
              exit 0
            fi
            sleep $((attempt * 10))
          done
          echo "::error title=未能触发生产发布::请手动运行「生产环境发布」，release_id 填 $RELEASE_ID"
          exit 1

  build-deploy-verify:
    name: 部署并校验精确的测试环境 RC
    needs: [prepare-evidence, prepare-acs]
    outputs:
      release_id: ${{ steps.lock_release.outputs.release_id }}
    # Only online mutation and validation own the Staging slot. Preparation can overlap.
    # GitHub keeps one pending intent; a newer dispatch replaces an ol