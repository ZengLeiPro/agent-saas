          # After staging_deployed/verified, keep the immutable attestation's deployment binding.
          deployment_id="$(node scripts/release/staging-deployment-retry.mjs \
            "$RUNNER_TEMP/attestations/$STAGING_RELEASE_ID.jsonl" "$STAGING_RELEASE_ID" "$MANIFEST_DIGEST" "$GITHUB_RUN_ID")"
          if [ -n "$deployment_id" ]; then
            gh api "repos/$GITHUB_REPOSITORY/deployments/$deployment_id" > "$RUNNER_TEMP/staging-deployment.json"
            jq -e --arg sha "$RELEASE_SOURCE_SHA" --arg rc "$STAGING_RELEASE_ID" \
              '.environment=="staging" and .sha==$sha and .payload.releaseId==$rc' \
              "$RUNNER_TEMP/staging-deployment.json" >/dev/null
          else
            source_binding=null
            if [ "$AUTOMATIC_RELEASE" = true ]; then
              source_binding="$(jq -c '{digest,stepId}' "$RUNNER_TEMP/staging-source-binding.json")"
            fi
            deployment_id="$(jq -n --arg ref "$RELEASE_SOURCE_SHA" --arg releaseId "$STAGING_RELEASE_ID" \
              --arg runId "$GITHUB_RUN_ID" --arg digest "$MANIFEST_DIGEST" \
              --arg runAttempt "$GITHUB_RUN_ATTEMPT" --argjson sourceBinding "$source_binding" \
              '{ref:$ref,environment:"staging",auto_merge:false,required_contexts:[],payload:({releaseId:$releaseId,stagingRunId:$runId,stagingRunAttempt:$runAttempt,manifestDigest:$digest} + if $sourceBinding == null then {} else {automaticSource:$sourceBinding} end)}' \
              | gh api --method POST "repos/$GITHUB_REPOSITORY/deployments" --input - --jq .id)"
          fi
          test "$deployment_id" -gt 0
          echo "STAGING_DEPLOYMENT_ID=$deployment_id" >> "$GITHUB_ENV"
          gh api --method POST "repos/$GITHUB_REPOSITORY/deployments/$deployment_id/statuses" \
            -f state=in_progress -f environment=staging \
            -f environment_url="$STAGING_WEB_URL" >/dev/null

      - name: 为当前 Runner 授权测试环境 SSH
        run: |
          set -euo pipefail
          runner_ip="$(curl -4 -fsS --retry 5 https://api.ipify.org)"
          node -e "if (!require('node:net').isIPv4(process.argv[1])) process.exit(1)" "$runner_ip"
          security_group_id="$(jq -r .resources.api.securityGroupId infra/staging/resource-plan.json)"
          printf '%s' "$security_group_id" | grep -Eq '^sg-[a-z0-9]+$'
          source_cidr="$runner_ip/32"
          {
            echo "STAGING_SSH_SECURITY_GROUP_ID=$security_group_id"
            echo "STAGING_SSH_SOURCE_CIDR=$source_cidr"
          } >> "$GITHUB_ENV"
          aliyun --region cn-shenzhen ecs AuthorizeSecurityGroup \
            --RegionId cn-shenzhen --SecurityGroupId "$security_group_id" \
            --IpProtocol TCP --PortRange 22/22 --SourceCidrIp "$source_cidr" \
            --Policy accept --Priority 1 \
            --Description "GitHub Staging SSH $GITHUB_RUN_ID/$GITHUB_RUN_ATTEMPT" \
            --ClientToken "staging-ssh-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >/dev/null

      - name: 配置测试环境 SSH
        run: |
          set -euo pipefail
          : "${STAGING_ECS_HOST:?Missing secret STAGING_ECS_HOST}"
          : "${STAGING_ECS_USER:?Missing secret STAGING_ECS_USER}"
          : "${STAGING_ECS_SSH_KEY:?Missing secret STAGING_ECS_SSH_KEY}"
          mkdir -p ~/.ssh && chmod 700 ~/.ssh
          printf '%s\n' "$STAGING_ECS_SSH_KEY" > ~/.ssh/staging_key
          chmod 600 ~/.ssh/staging_key
          : "${STAGING_SSH_HOST_KEY_SHA256:?Missing pinned Staging SSH host key fingerprint}"
          scan_path="$RUNNER_TEMP/staging-known-host"
          for attempt in 1 2 3 4 5; do
            if ssh-keyscan -T 10 -t ed25519 -H "$STAGING_ECS_HOST" > "$scan_path"; then
              break
            fi
            test "$attempt" -lt 5
            sleep 2
          done
          test -s "$scan_path"
          test "$(ssh-keygen -lf "$RUNNER_TEMP/staging-known-host" -E sha256 | awk '{print $2}')" = \
            "$STAGING_SSH_HOST_KEY_SHA256"
          cat "$RUNNER_TEMP/staging-known-host" >> ~/.ssh/known_hosts

      - name: 记录部署前测试环境组件状态
        run: bash scripts/release/observe-staging-state.sh before

      - name: 部署精确的测试环境 API、Worker 与 ACS 产物前重新核对父请求
        if: inputs.automation_id != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/release/automatic-release-child.mjs deploy-staging.yml

      - name: 部署精确的测试环境 API、Worker 与 ACS 产物
        run: |
          set -euo pipefail
          remote="/tmp/agent-saas-staging-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" "mkdir -p '$remote'"
          # 制品留在深圳 OSS。runner 只传脚本/清单/模板/预签名拉取计划，ECS 内网直拉并校验摘要。
          # 签名凭据只写 runner 私有文件，不进 env 扫描、不进 ECS 载荷。
          : "${ALIBABACLOUD_ACCESS_KEY_ID:?Missing staging secret ALIYUN_ACCESS_KEY_ID}"
          : "${ALIBABACLOUD_ACCESS_KEY_SECRET:?Missing staging secret ALIYUN_ACCESS_KEY_SECRET}"
          : "${STAGING_RELEASE_OSS_URI:?Missing staging variable STAGING_RELEASE_OSS_URI}"
          oss_sign_credentials="$RUNNER_TEMP/staging-oss-sign-credentials.json"
          (
            umask 077
            jq -n --arg accessKeyId "$ALIBABACLOUD_ACCESS_KEY_ID" \
              --arg accessKeySecret "$ALIBABACLOUD_ACCESS_KEY_SECRET" \
              '{accessKeyId:$accessKeyId,accessKeySecret:$accessKeySecret}' > "$oss_sign_credentials"
          )
          node scripts/release/sign-promotion-artifact-urls.mjs \
            "$RUNNER_TEMP/manifest.json" "$RELEASE_RECORD_OSS_REGION" \
            "$RUNNER_TEMP/staging-artifact-fetch-plan.json" \
            "$oss_sign_credentials" \
            "$RUNNER_TEMP/release/artifact-index.json" \
            "$STAGING_RELEASE_OSS_URI"
          # The deploy gate imports the shared strict private ConfigIdentity contract.
          scp -i ~/.ssh/staging_key "$RUNNER_TEMP/manifest.json" \
            "$RUNNER_TEMP/staging-artifact-fetch-plan.json" \
            scripts/release/deploy-staging-release.sh scripts/release/acs-deployment-drain.sh \
            scripts/release/prune-unreferenced-releases.sh \
            scripts/release/verify-installed-release.mjs \
            scripts/release/read-production-state.mjs scripts/release/read-runtime-identity.mjs scripts/release/config-publication.mjs \
            scripts/release/artifact-lib.mjs scripts/release/reuse-promotion-artifacts.mjs \
            daemon-packaging/systemd/agent-saas-server-staging.service.template \
            daemon-packaging/systemd/agent-saas-runtime-worker-staging.service.template \
            daemon-packaging/systemd/agent-saas-acs-orchestrator-staging.service.template \
            "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "node '$remote/reuse-promotion-artifacts.mjs' hydrate '$remote/staging-artifact-fetch-plan.json' '$remote' && \
             RELEASE_DIR='$remote/artifacts' UNIT_DIR='$remote' MANIFEST_PATH='$remote/manifest.json' EXPECTED_MANIFEST_DIGEST='$MANIFEST_DIGEST' STAGING_RUNTIME_ASSETS_PATH='$remote/artifacts/staging-runtime-assets.tgz' STAGING_RUNTIME_ASSETS_DIGEST='$(jq -r .stagingRuntimeAssetsDigest "$RUNNER_TEMP/staging-runtime-summary.json")' VERIFY_INSTALLED_SCRIPT='$remote/verify-installed-release.mjs' GITHUB_RUN_ID='$GITHUB_RUN_ID' GITHUB_RUN_ATTEMPT='$GITHUB_RUN_ATTEMPT' bash '$remote/deploy-staging-release.sh'"

      - name: 最后发布精确的测试环境 Web 产物
        run: |
          set -euo pipefail
          rm -rf "$RUNNER_TEMP/web-assets" && mkdir -p "$RUNNER_TEMP/web-assets"
          tar -xzf "$RUNNER_TEMP/selected/web-assets.tgz" -C "$RUNNER_TEMP/web-assets"
          jq -n \
            --arg releaseId "$STAGING_RELEASE_ID" --arg releaseSha "$(jq -r .components.web.sourceSha "$RUNNER_TEMP/manifest.json")" \
            --arg webDigest "$(jq -r .components.web.artifactDigest "$RUNNER_TEMP/manifest.json")" \
            --arg configFingerprint "$(jq -r .digest "$RUNNER_TEMP/manifest.json")" \
            '{schemaVersion:1,environment:"staging",releaseId:$releaseId,releaseSha:$releaseSha,webDigest:$webDigest,configFingerprint:$configFingerprint}' \
            > "$RUNNER_TEMP/web-assets/release-identity.json"
          aliyun --secure oss cp "$RUNNER_TEMP/web-assets/" "$STAGING_WEB_OSS_URI/" \
            --recursive --force --exclude index.html --exclude release-identity.json \
            --region "$RELEASE_RECORD_OSS_REGION"
          aliyun --secure oss cp "$RUNNER_TEMP/web-assets/release-identity.json" \
            "$STAGING_WEB_OSS_URI/release-identity.json" --force \
            --region "$RELEASE_RECORD_OSS_REGION"
          aliyun --secure oss cp "$RUNNER_TEMP/web-assets/index.html" \
            "$STAGING_WEB_OSS_URI/index.html" --force \
            --region "$RELEASE_RECORD_OSS_REGION"
          rm -rf "$RUNNER_TEMP/web-oss-readback"
          mkdir -p "$RUNNER_TEMP/web-oss-readback"
          export WEB_ASSETS_ROOT="$RUNNER_TEMP/web-assets"
          export WEB_OSS_READBACK_ROOT="$RUNNER_TEMP/web-oss-readback"
          export STAGING_WEB_OSS_URI RELEASE_RECORD_OSS_REGION
          find "$WEB_ASSETS_ROOT" -type f -print0 | \
            xargs -0 -r -P 8 -n 1 bash -euo pipefail -c '
              source="$1"
              relative="${source#"$WEB_ASSETS_ROOT/"}"
              target="$WEB_OSS_READBACK_ROOT/$relative"
              mkdir -p "$(dirname "$target")"
              aliyun --secure oss cp "$STAGING_WEB_OSS_URI/$relative" \
                "$target" --region "$RELEASE_RECORD_OSS_REGION"
              cmp "$source" "$target"
            ' _
          node scripts/release/verify-public-web.mjs "$RUNNER_TEMP/web-assets" "$STAGING_WEB_URL" \
            "$RUNNER_TEMP/staging-public-web.json"

      - name: 逐项核验本次迁移的数据库后置条件
        run: |
          set -euo pipefail
          remote="/tmp/agent-saas-staging-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          scp -i ~/.ssh/staging_key scripts/release/read-migration-postconditions.mjs \
            scripts/release/migration-postconditions.mjs "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "node '$remote/read-migration-postconditions.mjs' '$remote/manifest.json' /var/lib/agent-saas-staging/config/config.json /opt/agent-saas-staging/current/server staging '$remote/database-readback.json'"
          scp -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/database-readback.json" \
            "$RUNNER_TEMP/staging-database-readback.json"

      - name: 校验迁移与隔离的集成测试夹具
        run: |
          set -euo pipefail
          remote="/tmp/agent-saas-staging-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          scp -i ~/.ssh/staging_key scripts/staging/ensure-integration-fixture.mjs \
            "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "AGENT_SAAS_ENVIRONMENT=staging node '$remote/ensure-integration-fixture.mjs' '$STAGING_RELEASE_ID'" \
            > "$RUNNER_TEMP/staging-integration-fixture.json"
          test "$(jq -r .releaseId "$RUNNER_TEMP/staging-integration-fixture.json")" = \
            "$STAGING_RELEASE_ID"
          test "$(jq -r .migrationReadback.status "$RUNNER_TEMP/staging-integration-fixture.json")" = present
          test "$(jq -r .fixture.state "$RUNNER_TEMP/staging-integration-fixture.json")" = canceled
          test "$(jq -r .fixture.evidenceScope "$RUNNER_TEMP/staging-integration-fixture.json")" = \
            storage-and-authenticated-readback-only
          integration_task_id="$(jq -r .fixture.taskId "$RUNNER_TEMP/staging-integration-fixture.json")"
          test "$integration_task_id" = staging-e2e-integration-task

      - name: 验证登录、持久化读回与鉴权 WebSocket 核心路径
        timeout-minutes: 3
        run: |
          set -euo pipefail
          node scripts/staging/core-business-smoke.mjs "$RUNNER_TEMP/manifest.json" \
            "$RUNNER_TEMP/staging-integration-fixture.json" "$RUNNER_TEMP/staging-core-smoke.json"

      - name: 校验在线反向隔离证据
        run: |
          set -euo pipefail
          : "${STAGING_ISOLATION_EVIDENCE_URL:?Missing staging variable}"
          remote="/tmp/agent-saas-staging-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          scp -i ~/.ssh/staging_key infra/staging/resource-plan.json \
            scripts/staging/collect-isolation-host.mjs \
            scripts/staging/publish-isolation-evidence.mjs \
            "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "node '$remote/collect-isolation-host.mjs' staging '$STAGING_RELEASE_ID' '$remote/resource-plan.json'" \
            > "$RUNNER_TEMP/isolation-host-evidence.json"
          jq -nc --arg accessKeyId "$ALIYUN_ACCESS_KEY_ID" \
            --arg accessKeySecret "$ALIYUN_ACCESS_KEY_SECRET" \
            '{accessKeyId:$accessKeyId,accessKeySecret:$accessKeySecret}' | \
            node scripts/staging/collect-isolation-evidence.mjs \
              --release-id "$STAGING_RELEASE_ID" \
              --resource-plan infra/staging/resource-plan.json \
              --host-evidence "$RUNNER_TEMP/isolation-host-evidence.json" \
              --output "$RUNNER_TEMP/isolation-evidence-input.json"
          node scripts/staging/assert-isolation.mjs "$RUNNER_TEMP/isolation-evidence-input.json" \
            "$RUNNER_TEMP/isolation-summary-expected.json"
          scp -i ~/.ssh/staging_key "$RUNNER_TEMP/isolation-evidence-input.json" \
            "$STAGING_ECS_USER@$STAGING_ECS_HOST:$remote/isolation-evidence-input.json"
          ssh -i ~/.ssh/staging_key "$STAGING_ECS_USER@$STAGING_ECS_HOST" \
            "node '$remote/publish-isolation-evidence.mjs' staging '$STAGING_RELEASE_ID' '$remote/isolation-evidence-input.json'"
          curl -fsS -H "authorization: Bearer $RELEASE_EVIDENCE_TOKEN" \
            "$STAGING_ISOLATION_EVIDENCE_URL?releaseId=$STAGING_RELEASE_ID" \
            > "$RUNNER_TEMP/isolation-evidence.json"
          node scripts/staging/assert-isolation.mjs "$RUNNER_TEMP/isolation-evidence.json" \
            "$RUNNER_TEMP/isolation-summary.json"
          diff <(jq -S . "$RUNNER_TEMP/isolation-evidence-input.json") \
            <(jq -S . "$RUNNER_TEMP/isolation-evidence.json")
          diff <(jq -S 'del(.observedAt)' "$RUNNER_TEMP/isolation-summary-expected.json") \
            <(jq -S 'del(.observedAt)' "$RUNNER_TEMP/isolation-summary.json")
          test "$(jq -r .releaseId "$RUNNER_TEMP/isolation-evidence.json")" = "$STAGING_RELEASE_ID"
          jq --arg rc "$STAGING_RELEASE_ID" --arg digest "$MANIFEST_DIGEST" \
            --arg run "$GITHUB_RUN_ID" --arg attempt "$GITHUB_RUN_ATTEMPT" \
            '. + {releaseId:$rc,manifestDigest:$digest,stagingRunId:$run,stagingRunAttempt:$attempt}' \
            "$RUNNER_TEMP/isolation-summary.json" > "$RUNNER_TEMP/isolation-summary-bound.json"
          mv "$RUNNER_TEMP/isolation-summary-bound.json" "$RUNNER_TEMP/isolation-summary.json"
          echo "STAGING_ISOLATION_SUMMARY=$RUNNER_TEMP/isolation-summary.json" >> "$GITHUB_ENV"

      - name: 记录确定性的测试环境部署与校验结果
        if: success()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          log_root="$RUNNER_TEMP/attestations"
          current="$(tail -n1 "$log_root/$STAGING_RELEASE_ID.jsonl" | jq -r .state)"
          if [ "$current" = built ]; then
            verification_summary="$(jq -nc \
              '{schemaVersion:1,mode:"deterministic-deployment-gates-v2",status:"passed",checks:["immutable-artifacts","runtime-identity","api-readiness","acs-health","web-readback","migration-readback","reverse-isolation","core-business-smoke"]}')"
            staging_reason="$(jq -nc --arg deploymentId "$STAGING_DEPLOYMENT_ID" --arg stagingRunId "$GITHUB_RUN_ID" \
              --arg manifestDigest "$MANIFEST_DIGEST" --arg stagingRunAttempt "$GITHUB_RUN_ATTEMPT" \
              --argjson deploymentEngine "$(jq -c '{sourceSha,implementationDigest,contract}' "$RUNNER_TEMP/deployment-engine.json")" \
              --argjson runtimeSummary "$(cat "$RUNNER_TEMP/staging-runtime-summary.json")" \
              --argjson verificationSummary "$verification_summary" \
              '{deploymentEngine:$deploymentEngine,stagingDeploymentId:$deploymentId,stagingRunId:$stagingRunId,stagingRunAttempt:$stagingRunAttempt,manifestDigest:$manifestDigest,runtimeSummary:$runtimeSummary,verificationSummary:$verificationSummary}')"
            pnpm exec tsx server/src/release/releaseAttestationCli.ts \
              --root "$log_root" --release-id "$STAGING_RELEASE_ID" --digest "$MANIFEST_DIGEST" \
              --state staging_deployed --operation "staging:$GITHUB_RUN_ID:$GITHUB_RUN_ATTEMPT" \
              --actor "$GITHUB_ACTOR" --reason "$staging_reason"
            current=staging_deployed
          fi
          if [ "$current" = staging_deployed ]; then
            pnpm exec tsx server/src/release/releaseAttestationCli.ts \
              --root "$log_root" --release-id "$STAGING_RELEASE_ID" --digest "$MANIFEST_DIGEST" \
              --state verified --operation "deterministic:$GITHUB_RUN_ID:$GITHUB_RUN_ATTEMPT" \
              --actor "$GITHUB_ACTOR"
            current=verified
          fi
          test "$current" = verified
          snapshot_json="$(node scripts/release/attestation-snapshot.mjs create \
            "$log_root/$STAGING_RELEASE_ID.jsonl" "$RUNNER_TEMP/attestation-snapshots")"
          snapshot_path="$(printf '%s' "$snapshot_json" | jq -r .path)"
          bash scripts/release/upload-oss-object-immutable.sh "$snapshot_path" \
            "$STAGING_RELEASE_OSS_URI/records/$STAGING_RELEASE_ID/attestations/$(basename "$snapshot_path")"
          if gh release view "$STAGING_RELEASE_ID" >/dev/null 2>&1; then
            bash scripts/release/upload-github-release-asset-immutable.sh \
              "$STAGING_RELEASE_ID" "$snapshot_path"
          fi

      - name: 最终对账并阻止混合版本验收
        if: always() && env.STAGING_DEPLOYMENT_ID != ''
        run: bash scripts/release/observe-staging-state.sh final "${{ job.status }}"

      - name: 撤销临时测试环境 SSH 入站授权
        if: always() && env.STAGING_SSH_SOURCE_CIDR != ''
        run: |
          set -euo pipefail
          for attempt in 1 2 3 4 5; do
            if aliyun --region cn-shenzhen ecs RevokeSecurityGroup \
              --RegionId cn-shenzhen --SecurityGroupId "$STAGING_SSH_SECURITY_GROUP_ID" \
              --IpProtocol TCP --PortRange 22/22 --SourceCidrIp "$STAGING_SSH_SOURCE_CIDR" \
              --Policy accept --Priority 1 >/dev/null; then
              exit 0
            fi
            test "$attempt" -lt 5
            sleep 2
          done

      - name: 校验完整的测试环境证据包
        if: success()
        run: |
          set -euo pipefail
          for evidence in manifest.json isolation-summary.json staging-runtime-summary.json \
            staging-integration-fixture.json staging-core-smoke.json; do
            test -f "$RUNNER_TEMP/$evidence"
          done

      - name: 上传独立测试环境证据
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: staging-evidence-${{ env.STAGING_RELEASE_ID }}-${{ github.run_attempt }}
          if-no-files-found: warn
          retention-days: 90
          path: |
            ${{ runner.temp }}/manifest.json
            ${{ runner.temp }}/isolation-summary.json
            ${{ runner.temp }}/staging-runtime-summary.json
            ${{ runner.temp }}/staging-integration-fixture.json
            ${{ runner.temp }}/staging-core-smoke.json
            ${{ runner.temp }}/staging-database-readback.json
            ${{ runner.temp }}/staging-public-web.json
            ${{ runner.temp }}/deployment-engine.json
            ${{ runner.temp }}/staging-source-binding.json
            ${{ runner.temp }}/authoritative-evidence.json
            ${{ runner.temp }}/staging-before.json
            ${{ runner.temp }}/staging-final.json
            ${{ runner.temp }}/automatic-child-authorization.jsonl

      - name: 完成 GitHub 测试环境部署记录
        if: always() && env.STAGING_DEPLOYMENT_ID != ''
        env:
          GH_TOKEN: ${{ github.token }}
          WORKFLOW_STATUS: ${{ job.status }}
        run: |
          state=failure
          [ "$WORKFLOW_STATUS" = success ] && state=success
          gh api --method POST "repos/$GITHUB_REPOSITORY/deployments/$STAGING_DEPLOYMENT_ID/statuses" \
            -f state="$state" -F auto_inactive=false -f environment=staging -f environment_url="$STAGING_WEB_URL" \
            -f log_url="https://github.com/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/attempts/$GITHUB_RUN_ATTEMPT" >/dev/null
